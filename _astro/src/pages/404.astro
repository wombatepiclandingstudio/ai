---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="The page you are looking for does not exist.">
  <main id="main-content" class="mx-auto max-w-3xl px-4 py-24 text-center">
    <h1 class="text-6xl font-bold text-slate-100">404</h1>
    <p class="mt-4 text-lg text-slate-300">The page you are looking for does not exist.</p>
    <p class="mt-2 text-sm text-slate-500">It may have been moved, renamed, or removed.</p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href="/" class="rounded-lg bg-indigo-500 px-5 py-2.5 font-semibold text-white transition hover:bg-indigo-400">Go home</a>
      <a href="/skills/" class="rounded-lg border border-slate-700 px-5 py-2.5 font-semibold text-slate-100 transition hover:border-indigo-400">Browse skills</a>
      <a href="/agents/" class="rounded-lg border border-slate-700 px-5 py-2.5 font-semibold text-slate-100 transition hover:border-indigo-400">Browse agents</a>
    </div>
  </main>
</Base>