---
import Base from '../../layouts/Base.astro';
import ContentCard from '../../components/ContentCard.astro';
import Footer from '../../components/Footer.astro';
import InstallModal from '../../components/InstallModal.astro';
import { getSkills } from '../../lib/scan-content';

const skills = await getSkills();
---

<Base title="Skills" description="Ready-made skills you can drop into Claude, Codex, Cursor, Kilo, OpenCode and more.">
  <main id="main-content" class="mx-auto max-w-5xl px-4 py-16">
    <div class="mb-8">
      <h1 class="text-3xl font-bold">Skills</h1>
      <p class="mt-2 text-slate-400">
        Ready-made skills — point the installer at a project or your home folder
        and they show up in your tools.
      </p>
    </div>

    <div class="mb-6">
      <label for="skill-search" class="sr-only">Search skills</label>
      <input
        id="skill-search"
        type="search"
        placeholder="Search skills…"
        class="w-full rounded-lg border border-slate-700 bg-slate-900 px-4 py-2 text-sm text-slate-100 placeholder-slate-500 focus:border-indigo-400 focus:outline-none"
        data-search
        data-search-target="skills-grid"
      />
    </div>

    {skills.length > 0 ? (
      <div id="skills-grid" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-search-list>
        {skills.map((s) => <ContentCard kind="skill" item={s} />)}
      </div>
    ) : (
      <p class="rounded-xl border border-dashed border-slate-800 p-8 text-center text-slate-500">
        No skills found in the repository yet.
      </p>
    )}
  </main>
  <Footer />
  <InstallModal kind="skill" />
</Base>

<script>
  document.querySelectorAll<HTMLInputElement>('[data-search]').forEach((input) => {
    const targetId = input.dataset.searchTarget!;
    const list = document.getElementById(targetId)!;

    function filter() {
      const query = input.value.toLowerCase();
      list.querySelectorAll<HTMLElement>('[data-search-list] > *').forEach((card) => {
        const text = card.textContent?.toLowerCase() ?? '';
        card.style.display = text.includes(query) ? '' : 'none';
      });
    }

    input.addEventListener('input', filter);
  });
</script>
