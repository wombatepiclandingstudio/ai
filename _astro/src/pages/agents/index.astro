---
import Base from '../../layouts/Base.astro';
import ContentCard from '../../components/ContentCard.astro';
import Footer from '../../components/Footer.astro';
import InstallModal from '../../components/InstallModal.astro';
import { getAgents } from '../../lib/scan-content';

const agents = await getAgents();
---

<Base title="Agents" description="Hand-written agent definitions you can drop into Claude, Codex, Cursor, Kilo, OpenCode and more.">
  <main id="main-content" class="mx-auto max-w-5xl px-4 py-16">
    <div class="mb-8">
      <h1 class="text-3xl font-bold">Agents</h1>
      <p class="mt-2 text-slate-400">
        Hand-written agent definitions you add to a tool's agents directory.
      </p>
    </div>

    <div class="mb-6">
      <label for="agent-search" class="sr-only">Search agents</label>
      <input
        id="agent-search"
        type="search"
        placeholder="Search agents…"
        class="w-full rounded-lg border border-slate-700 bg-slate-900 px-4 py-2 text-sm text-slate-100 placeholder-slate-500 focus:border-indigo-400 focus:outline-none"
        data-search
        data-search-target="agents-grid"
      />
    </div>

    {agents.length > 0 ? (
      <div id="agents-grid" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-search-list>
        {agents.map((a) => <ContentCard kind="agent" item={a} />)}
      </div>
    ) : (
      <p class="rounded-xl border border-dashed border-slate-800 p-8 text-center text-slate-500">
        No agents found in the repository yet.
      </p>
    )}
  </main>
  <Footer />
  <InstallModal kind="agent" />
</Base>

<script>
  document.querySelectorAll<HTMLInputElement>('[data-search]').forEach((input) => {
    const targetId = input.dataset.searchTarget!;
    const list = document.getElementById(targetId)!;

    function filter() {
      const query = input.value.toLowerCase();
      list.querySelectorAll<HTMLElement>(':scope > *').forEach((card) => {
        const text = card.textContent?.toLowerCase() ?? '';
        card.style.display = text.includes(query) ? '' : 'none';
      });
    }

    input.addEventListener('input', filter);
  });
</script>
