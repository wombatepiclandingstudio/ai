---
import { GITHUB_URL, NAV_ITEMS } from '../lib/constants';
const home = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const currentPath = Astro.url.pathname.replace(/\/?$/, '/');
---

<header class="sticky top-0 z-20 border-b border-slate-800/80 bg-slate-950/80 backdrop-blur">
  <nav class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3" aria-label="Main navigation">
    <a href={home} class="flex items-center gap-2 font-semibold" aria-label="Home">
      <span class="grid h-7 w-7 place-items-center rounded-md bg-indigo-500/20 text-indigo-300" aria-hidden="true">AI</span>
      <span>skills &amp; agents</span>
    </a>
    <div class="flex items-center gap-3 text-sm">
      {NAV_ITEMS.map((item) => {
        const href = item.href.startsWith('#') ? `${home}${item.href}` : `${home}${item.href}`;
        const isActive = currentPath.endsWith(item.href.replace(/\/$/, '')) || (item.href === '#install' && currentPath === home);
        return (
          <a
            href={href}
            class={`hidden text-sm transition hover:text-white sm:block ${isActive ? 'text-white font-medium' : 'text-slate-300'}`}
            aria-current={isActive ? 'page' : undefined}
          >
            {item.label}
          </a>
        );
      })}
      <a
        href={GITHUB_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-md border border-slate-700 px-3 py-1.5 font-medium text-slate-100 transition hover:border-indigo-400 hover:text-white"
      >
        ★ Star
      </a>
      <button
        type="button"
        data-nav-toggle
        class="rounded-md p-1.5 text-slate-300 hover:text-white sm:hidden"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="nav-mobile"
      >
        <svg data-nav-open width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"></path></svg>
        <svg data-nav-close class="hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </div>
  </nav>
  <div id="nav-mobile" data-nav-mobile class="hidden border-t border-slate-800/80 bg-slate-950/95 backdrop-blur sm:hidden" aria-hidden="true" role="menu">
    <div class="mx-auto flex max-w-5xl flex-col gap-1 px-4 py-3">
      {NAV_ITEMS.map((item) => {
        const href = item.href.startsWith('#') ? `${home}${item.href}` : `${home}${item.href}`;
        return (
          <a
            href={href}
            role="menuitem"
            class="rounded-lg px-3 py-2 text-sm text-slate-300 hover:bg-slate-800 hover:text-white"
          >
            {item.label}
          </a>
        );
      })}
      <a
        href={GITHUB_URL}
        target="_blank"
        rel="noopener noreferrer"
        role="menuitem"
        class="rounded-lg px-3 py-2 text-sm text-slate-300 hover:bg-slate-800 hover:text-white"
      >★ Star on GitHub</a>
    </div>
  </div>
</header>

<script>
  function initNav() {
    const toggle = document.querySelector<HTMLElement>('[data-nav-toggle]');
    const mobile = document.querySelector<HTMLElement>('[data-nav-mobile]');
    const openIcon = toggle?.querySelector<HTMLElement>('[data-nav-open]');
    const closeIcon = toggle?.querySelector<HTMLElement>('[data-nav-close]');
    if (!toggle || !mobile || !openIcon || !closeIcon) return;

    function open() {
      toggle.setAttribute('aria-expanded', 'true');
      mobile.classList.remove('hidden');
      mobile.setAttribute('aria-hidden', 'false');
      openIcon.classList.add('hidden');
      closeIcon.classList.remove('hidden');
    }

    function close() {
      toggle.setAttribute('aria-expanded', 'false');
      mobile.classList.add('hidden');
      mobile.setAttribute('aria-hidden', 'true');
      openIcon.classList.remove('hidden');
      closeIcon.classList.add('hidden');
    }

    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      if (expanded) {
        close();
      } else {
        open();
      }
    });

    mobile.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        close();
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        close();
        toggle.focus();
      }
    });
  }

  initNav();
</script>
